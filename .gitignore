# Dependencies
node_modules
.npm/

# Build output
dist/
packages/*/dist/
packages/*/dist-chrome/
packages/*/dist-firefox/
target/
.xwin-cache/
*.tsbuildinfo
*.node
*.b64.js
/result
/result-*

# Environment
.env
.venv

# WSL-local toolchain (bun/bazel/rustup homes) for building natives without
# VS Build Tools; never committed
.wsl-env/

# Gitea local-ci toolchain home (.gitea/workflows/local-ci.yml installs bun /
# rustup / cargo / node / go here so runs stay incremental across executions).
# It lives inside the runner workspace on purpose — a per-run ephemeral HOME
# would throw the caches away after every job.
/.tools/

# Editors
.vscode/
.zed/
.idea/
*.swp
*.swo
*.kate-swp
*~

# OS
*.tmp
# Bun compile temp artifacts, left in cwd if a `Bun.build({ compile })` run is killed mid-write
*.bun-build
.DS_Store

# Logs & profiling
*.log
tui-debug.log
*.cpuprofile

# Test & coverage
coverage/
.nyc_output/
packages/ai/test/.temp-images/

# Project specific
.zeta/
.pi_config/
.opencode/
.worktrees/
.worktree/
compaction-results/
changes/
__pycache__/

# Scratch files
temp/
/modernization-plan*.md
syntax.jsonl
out.jsonl
out.html
pi-*.html
.close_issue.sh

# Generated files
packages/coding-agent/src/export/html/tool-views.generated.js
packages/natives/npm/
# prepack materializes the repo-root skills/ tree into the package dir for the
# npm tarball (see packages/coding-agent/scripts/sync-official-skills.ts)
packages/coding-agent/skills/
/runs/
sdk/python/omp-rpc/src/omp_rpc.egg-info/
sdk/python/omp-rpc/build/
# parallel-agent worktrees
.wt/
CPU*.md
packages/coding-agent/binaries/

# robomp runtime state
python/robomp/data/
python/robomp/.cache/
python/robomp/src/robomp/static/
python/robomp/web/dist/
python/robomp/web/verify-out/
/verify-out/
python/robomp/.env

# Local, machine-specific boot perf baseline (see packages/coding-agent/scripts/bench-guard.ts)
packages/coding-agent/bench/boot-baseline.json

# Bazel
/bazel-bin
/bazel-out
/bazel-testlogs
/bazel-pi
/bazel-oh-my-pi
/.bazelrc.user

# Local-only session handoff notes (never commit; anchored so vendored
# termide assets (agent-core/assets/system/handoff.md) are NOT excluded)
/HANDOFF.md

# Agent / IDE local state (never commit)
.mimosa/
.workbuddy/

# ZCode session-local planning artifacts (never shipped)
.zcode/
.parity/

# In-repo runtime artifacts (merge scope reports etc.)
.zeta/

# editor (vendored TTT Editor) build artifacts (root-anchored: editor/npm/*/bin must stay tracked)
/editor/bin/
/editor/ttt
/editor/ttt.exe
