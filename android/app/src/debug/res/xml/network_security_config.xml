<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug only: allow a locally installed development CA. TLS errors are
         still cancelled by the WebView client; this never permits cleartext. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
