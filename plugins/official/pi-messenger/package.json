{
	"name": "@linxiraos/pi-messenger",
	"version": "1.3.1",
	"description": "Inter-agent messaging and file reservation system for pi coding agent",
	"keywords": [
		"agents",
		"ai",
		"cli",
		"coordination",
		"extension",
		"messaging",
		"multi-agent",
		"pi",
		"pi-coding-agent",
		"pi-package"
	],
	"homepage": "https://github.com/Linxira-OS/linxira-zeta/tree/main/plugins/official/pi-messenger#readme",
	"bugs": {
		"url": "https://github.com/nicobailon/pi-messenger/issues"
	},
	"license": "MIT",
	"author": "Nico Bailon",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Linxira-OS/linxira-zeta.git",
		"directory": "plugins/official/pi-messenger"
	},
	"bin": {
		"pi-messenger": "install.mjs"
	},
	"files": [
		"*.ts",
		"*.mjs",
		"crew/**",
		"skills/**",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"THIRD-PARTY-NOTICES.txt"
	],
	"type": "module",
	"main": "index.ts",
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"vitest": "^2.1.8"
	},
	"peerDependencies": {
		"@linxiraos/pi-agent-core": "*",
		"@linxiraos/pi-ai": "*",
		"@linxiraos/pi-tui": "*",
		"@linxiraos/pi-utils": "*",
		"@linxiraos/zeta": "*",
		"typebox": "*"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"skills": [
			"./skills"
		]
	}
}
