{
	"name": "@linxiraos/pi-utils",
	"version": "1.1.12",
	"description": "Shared utilities for pi packages",
	"keywords": [
		"utilities",
		"cli",
		"logging",
		"streams"
	],
	"homepage": "https://linxira-os.github.io/zeta/",
	"bugs": {
		"url": "https://github.com/Linxira-OS/linxira-zeta/issues"
	},
	"license": "MIT",
	"author": "Can Boluk",
	"repository": {
		"directory": "packages/utils",
		"url": "git+https://github.com/Linxira-OS/linxira-zeta.git",
		"type": "git"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./ar": {
			"types": "./src/ar/index.ts",
			"import": "./src/ar/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		},
		"./*.js": "./src/*.ts"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"test": "bun test --parallel"
	},
	"dependencies": {
		"@linxiraos/pi-natives": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
