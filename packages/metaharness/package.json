{
  "type": "module",
  "private": true,
  "name": "@linxiraos/pi-metaharness",
  "version": "0.0.1",
  "description": "Unified benchmark runners plus Harbor run storage, REST/SSE APIs, and a live web dashboard",
  "homepage": "https://linxira-os.github.io/zeta/",
  "author": "Linxira-OS",
  "license": "MIT",
  "repository": {
    "directory": "packages/metaharness",
    "url": "git+https://github.com/Linxira-OS/linxira-zeta.git",
    "type": "git"
  },
  "bin": {
    "metaharness": "src/server.ts"
  },
  "scripts": {
    "check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
    "check:types": "bun check --no-script -p tsconfig.json && bun check --no-script -p src/tb/tsconfig.json && bun check --no-script -p adapters/edit/tsconfig.json && bun check --no-script -p scripts/tsconfig.json",
    "lint": "oxlint .",
    "serve": "bun run src/server.ts",
    "bench:edit": "bun adapters/edit/cli.ts",
    "bench:tb": "bun src/tb/cli.ts",
    "bench:tb-floor": "bun scripts/tb-floor.ts",
    "dev": "bun --hot src/server.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@linxiraos/pi-agent-core": "catalog:",
    "@linxiraos/pi-ai": "catalog:",
    "@linxiraos/pi-catalog": "catalog:",
    "@linxiraos/zeta": "catalog:",
    "@linxiraos/pi-utils": "catalog:",
    "@linxiraos/typescript-edit-benchmark": "workspace:*",
    "@stencil-hq/vibemon": "^0.3.2",
    "@linxiraos/pi-natives": "catalog:",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
