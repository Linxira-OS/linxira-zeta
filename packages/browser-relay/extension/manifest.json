{
	"manifest_version": 3,
	"name": "Zeta Browser Relay",
	"version": "0.2.0",
	"description": "zeta in Chrome: a side panel for zeta sessions that drive your real tabs through the local zeta relay.",
	"author": "Stencil Labs, Inc.",
	"homepage_url": "https://zeta.sh",
	"minimum_chrome_version": "120",
	"permissions": [
		"debugger",
		"tabs",
		"tabGroups",
		"storage",
		"unlimitedStorage",
		"alarms",
		"scripting",
		"downloads",
		"sidePanel",
		"nativeMessaging",
		"notifications",
		"offscreen"
	],
	"host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "background.js"
	},
	"side_panel": {
		"default_path": "panel.html"
	},
	"action": {
		"default_title": "zeta",
		"default_icon": {
			"16": "icons/zeta-16.png",
			"32": "icons/zeta-32.png",
			"48": "icons/zeta-48.png",
			"128": "icons/zeta-128.png"
		}
	},
	"icons": {
		"16": "icons/zeta-16.png",
		"32": "icons/zeta-32.png",
		"48": "icons/zeta-48.png",
		"128": "icons/zeta-128.png"
	},
	"commands": {
		"toggle-side-panel": {
			"description": "Open zeta",
			"suggested_key": {
				"default": "Ctrl+E",
				"mac": "Command+E"
			}
		}
	}
}
