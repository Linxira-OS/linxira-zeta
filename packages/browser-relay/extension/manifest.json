{
	"manifest_version": 3,
	"name": "Zeta Browser Relay",
	"version": "0.1.0",
	"description": "Lets the zetacode coding agent drive your existing tabs through a local CDP relay.",
	"author": "Linxira-OS",
	"homepage_url": "https://linxira-os.github.io/zeta/",
	"permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
	"background": {
		"service_worker": "background.js"
	},
	"options_page": "options.html",
	"action": {
		"default_title": "Zeta Browser Relay (click for settings)"
	}
}
