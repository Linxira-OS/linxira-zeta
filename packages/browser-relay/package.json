{
  "type": "module",
  "name": "@linxiraos/browser-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that lets the omp browser tool drive your existing tabs (relay server lives in the omp CLI: `omp browser-relay`)",
  "homepage": "https://github.com/Linxira-OS/linxira-zeta",
  "author": "Can Boluk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linxira-OS/linxira-zeta.git",
    "directory": "packages/browser-relay"
  },
  "scripts": {
    "build": "bun scripts/build-extension.ts",
    "check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '*.ts' && tsgo -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt 'src/**/*.{ts,tsx}' '*.ts'",
    "fix": "oxlint --fix . && oxfmt 'src/**/*.{ts,tsx}' '*.ts'"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "puppeteer-core": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
