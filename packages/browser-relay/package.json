{
	"name": "@linxiraos/browser-relay",
	"version": "0.1.0",
	"private": true,
	"description": "Chrome extension that lets the zeta browser tool drive your existing tabs (relay server lives in the zeta CLI: `zetacode browser-relay`)",
	"homepage": "https://zeta.sh",
	"license": "MIT",
	"author": {
		"name": "Stencil Labs, Inc.",
		"url": "https://linxira-os.github.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Linxira-OS/linxira-zeta.git",
		"directory": "packages/browser-relay"
	},
	"type": "module",
	"scripts": {
		"build": "bun scripts/build-extension.ts",
		"gen:embedded": "bun scripts/build-extension.ts --embedded",
		"test": "bun test",
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
		"check:types": "bun check --no-script -p tsconfig.json",
		"lint": "oxlint .",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'"
	},
	"dependencies": {
		"@linxiraos/browser-panel": "workspace:*",
		"@linxiraos/pi-tui": "catalog:",
		"@linxiraos/pi-utils": "catalog:",
		"@linxiraos/pi-wire": "catalog:",
		"gifenc": "1.0.3",
		"lucide-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/chrome": "0.3.7",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"puppeteer-core": "catalog:"
	},
	"engines": {
		"bun": ">=1.4.4"
	}
}
