{
	"exports": {
		"./*.js": "./src/*.ts",
		"./client/components/*": {
			"import": "./src/client/components/*.ts",
			"types": "./src/client/components/*.ts"
		},
		"./client/*": {
			"import": "./src/client/*.ts",
			"types": "./src/client/*.ts"
		},
		"./client": {
			"import": "./src/client/index.tsx",
			"types": "./src/client/index.tsx"
		},
		"./*": {
			"import": "./src/*.ts",
			"types": "./src/*.ts"
		},
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"build.ts",
		"tailwind.config.js",
		"README.md",
		"CHANGELOG.md"
	],
	"engines": {
		"bun": ">=1.3.14"
	},
	"devDependencies": {
		"postcss": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/react": "catalog:",
		"@types/bun": "catalog:"
	},
	"dependencies": {
		"@linxiraos/pi-utils": "catalog:",
		"@linxiraos/pi-catalog": "catalog:",
		"@linxiraos/pi-ai": "catalog:",
		"tailwindcss": "catalog:",
		"react-dom": "catalog:",
		"react-chartjs-2": "catalog:",
		"react": "catalog:",
		"lucide-react": "catalog:",
		"chart.js": "catalog:",
		"@tailwindcss/node": "catalog:"
	},
	"scripts": {
		"check:types": "tsgo -p tsconfig.json --noEmit && tsgo -p tsconfig.client.json --noEmit",
		"check": "tsgo -p tsconfig.json --noEmit",
		"dev": "bun run src/index.ts",
		"build": "bun run build.ts",
		"gen:stats:reset": "bun scripts/generate-client-bundle.ts --reset",
		"gen:stats": "bun scripts/generate-client-bundle.ts --generate"
	},
	"bin": {
		"zeta-stats": "./src/index.ts"
	},
	"types": "./src/index.ts",
	"main": "./src/index.ts",
	"keywords": [
		"ai",
		"observability",
		"metrics",
		"dashboard",
		"llm",
		"statistics"
	],
	"bugs": {
		"url": "https://github.com/Linxira-OS/linxira-zeta/issues"
	},
	"repository": {
		"directory": "packages/stats",
		"url": "git+https://github.com/Linxira-OS/linxira-zeta.git",
		"type": "git"
	},
	"license": "MIT",
	"author": "Can Boluk",
	"homepage": "https://linxira-os.github.io/zeta/",
	"description": "Local observability dashboard for pi AI usage statistics",
	"version": "1.1.9",
	"name": "@linxiraos/pi-stats",
	"type": "module"
}
