{
	"exports": {
		"./*": {
			"import": "./src/*.ts",
			"types": "./src/*.ts"
		},
		"./snapcompact": {
			"import": "./src/snapcompact.ts",
			"types": "./src/snapcompact.ts"
		},
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"engines": {
		"bun": ">=1.3.14"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	},
	"dependencies": {
		"@linxiraos/pi-wire": "catalog:",
		"@linxiraos/pi-utils": "catalog:",
		"@linxiraos/pi-natives": "catalog:",
		"@linxiraos/pi-catalog": "catalog:",
		"@linxiraos/pi-ai": "catalog:"
	},
	"scripts": {
		"test": "bun test --parallel",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"types": "./src/index.ts",
	"main": "./src/index.ts",
	"keywords": [
		"context-compression",
		"vision",
		"compaction",
		"llm"
