{
	"name": "@linxiraos/collab-web",
	"version": "1.0.0",
	"private": true,
	"description": "Browser guest client and local relay tools for omp collab live sessions",
	"keywords": [
		"agent",
		"collab",
		"react",
		"relay",
		"websocket"
	],
	"homepage": "https://linxira-os.github.io/zeta/",
	"bugs": {
		"url": "https://github.com/Linxira-OS/linxira-zeta/issues"
	},
	"license": "MIT",
	"author": "Can Boluk",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Linxira-OS/linxira-zeta.git",
		"directory": "packages/collab-web"
	},
	"files": [
		"dist",
		"src",
		"scripts",
		"public",
		"index.html",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"scripts": {
		"dev": "bun ./index.html",
		"mock-host": "bun scripts/mock-host.ts",
		"relay": "bun scripts/local-relay.ts",
		"build": "rm -rf dist && bun build ./index.html --outdir=dist --minify --entry-naming=[hash].[ext] --chunk-naming=[hash].[ext] --asset-naming=[hash].[ext] && mv dist/*.html dist/index.html && cp -R public/. dist/",
		"gen:tool-views": "bun scripts/build-tool-views.ts",
		"prepack": "bun run build",
		"test": "bun test --parallel",
		"check": "oxlint . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"fix": "oxfmt .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@linxiraos/pi-utils": "catalog:",
		"@linxiraos/pi-wire": "catalog:",
		"katex": "catalog:",
		"lucide-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
