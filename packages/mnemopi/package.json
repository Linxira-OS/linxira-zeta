{
	"exports": {
		"./*.js": "./src/*.ts",
		"./*": {
			"import": "./src/*.ts",
			"types": "./src/*.ts"
		},
		"./cli": {
			"import": "./src/cli.ts",
			"types": "./src/cli.ts"
		},
		"./mcp": {
			"import": "./src/mcp-tools.ts",
			"types": "./src/mcp-tools.ts"
		},
		"./diagnose": {
			"import": "./src/diagnose.ts",
			"types": "./src/diagnose.ts"
		},
		"./beam": {
			"import": "./src/core/beam/index.ts",
			"types": "./src/core/beam/index.ts"
		},
		"./core/beam": {
			"import": "./src/core/beam/index.ts",
			"types": "./src/core/beam/index.ts"
		},
		"./core": {
			"import": "./src/core/index.ts",
			"types": "./src/core/index.ts"
		},
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"engines": {
		"bun": ">=1.3.14"
	},
	"devDependencies": {
		"onnxruntime-node": "catalog:",
		"fastembed": "catalog:",
		"@types/bun": "catalog:"
	},
	"peerDependenciesMeta": {
		"onnxruntime-node": {
			"optional": true
		},
		"fastembed": {
			"optional": true
		}
	},
	"peerDependencies": {
		"onnxruntime-node": "1.21.0",
		"fastembed": "2.1.0"
	},
	"dependencies": {
		"@linxiraos/pi-utils": "catalog:",
		"@linxiraos/pi-natives": "catalog:",
		"@linxiraos/pi-catalog": "catalog:",
		"@linxiraos/pi-ai": "catalog:"
	},
	"scripts": {
		"test": "bun test --parallel",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"bin": {
		"mnemopi": "src/cli.ts"
	},
	"types": "./src/index.ts",
	"module": "./src/index.ts",
	"main": "./src/index.ts",
	"keywords": [
		"memory",
		"sqlite",
		"agent",
		"embeddings",
		"mcp"
	],
	"bugs": {
		"url": "https://github.com/Linxira-OS/linxira-zeta/issues"
	},
	"repository": {
		"directory": "packages/mnemopi",
		"url": "git+https://github.com/Linxira-OS/linxira-zeta.git",
		"type": "git"
	},
	"license": "MIT",
	"contributors": [
		"Abdias J"
	],
	"author": "Can Boluk",
	"homepage": "https://linxira-os.github.io/zeta/",
	"description": "Local SQLite memory engine for Oh My Pi agents",
	"version": "1.1.8",
	"name": "@linxiraos/pi-mnemopi",
	"type": "module"
}
