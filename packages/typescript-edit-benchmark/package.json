{
	"name": "@linxiraos/typescript-edit-benchmark",
	"version": "0.0.1",
	"private": true,
	"description": "Edit benchmark suite using TypeScript source code mutations",
	"homepage": "https://linxira-os.github.io/zeta/",
	"license": "MIT",
	"author": "Can Boluk",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Linxira-OS/linxira-zeta.git",
		"directory": "packages/typescript-edit-benchmark"
	},
	"type": "module",
	"exports": {
		"./*.js": "./src/*.ts",
		"./*": {
			"import": "./src/*.ts",
			"types": "./src/*.ts"
		}
	},
	"scripts": {
		"edit-shapes": "bun run src/edit-shape-stats.ts",
		"generate": "bun run src/generate.ts --typescript-dir /tmp/pi-mono-source",
		"test": "bun test --parallel",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@babel/generator": "catalog:",
		"@babel/parser": "catalog:",
		"@babel/traverse": "catalog:",
		"@babel/types": "catalog:",
		"@linxiraos/pi-agent-core": "catalog:",
		"@linxiraos/pi-ai": "catalog:",
		"@linxiraos/pi-natives": "catalog:",
		"@linxiraos/pi-tui": "catalog:",
		"@linxiraos/pi-utils": "catalog:",
		"@linxiraos/zeta": "catalog:",
		"diff": "catalog:",
		"prettier": "catalog:",
		"regexp-tree": "catalog:"
	},
	"devDependencies": {
		"@types/babel__generator": "catalog:",
		"@types/babel__traverse": "catalog:",
		"@types/bun": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
