{
	"exports": {
		"./*.js": "./src/*.ts",
		"./*": {
			"import": "./src/*.ts",
			"types": "./src/*.ts"
		},
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"engines": {
		"bun": ">=1.3.14"
	},
	"peerDependencies": {
		"@linxiraos/pi-ai": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@linxiraos/pi-ai": "catalog:"
	},
	"dependencies": {
		"@larksuiteoapi/node-sdk": "^1.71.1",
		"@linxiraos/pi-utils": "catalog:"
	},
	"scripts": {
		"test": "bun test --parallel",
		"fmt": "oxfmt 'src/**/*.{ts,tsx}' '*.{ts,tsx}'",
		"fix": "oxlint --fix . && oxfmt 'src/**/*.{ts,tsx}' '*.{ts,tsx}'",
		"lint": "oxlint .",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '*.{ts,tsx}' && bun run check:types"
	},
	"types": "./src/index.ts",
	"main": "./src/index.ts",
	"keywords": [
		"wechat",
		"feishu",
		"telegram",
		"channels",
		"im"
	],
	"bugs": {
		"url": "https://github.com/Linxira-OS/linxira-zeta/issues"
	},
	"repository": {
		"directory": "packages/channels",
		"url": "git+https://github.com/Linxira-OS/linxira-zeta.git",
		"type": "git"
	},
	"license": "MIT",
	"author": "Can Boluk",
	"homepage": "https://linxira-os.github.io/zeta/",
	"description": "IM channel adapters for Zeta (WeChat / Feishu / Telegram)",
	"type": "module",
	"version": "1.1.14",
	"name": "@linxiraos/pi-channels"
}
