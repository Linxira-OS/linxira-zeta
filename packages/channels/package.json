{
	"name": "@linxiraos/pi-channels",
	"version": "1.1.9",
	"description": "IM channel adapters for Zeta (WeChat / Feishu / Telegram)",
	"keywords": [
		"channels",
		"feishu",
		"im",
		"telegram",
		"wechat"
	],
	"homepage": "https://linxira-os.github.io/zeta/",
	"bugs": {
		"url": "https://github.com/Linxira-OS/linxira-zeta/issues"
	},
	"license": "MIT",
	"author": "Can Boluk",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Linxira-OS/linxira-zeta.git",
		"directory": "packages/channels"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		"./*.js": "./src/*.ts",
		"./*": {
			"import": "./src/*.ts",
			"types": "./src/*.ts"
		},
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		}
	},
	"scripts": {
		"test": "bun test --parallel",
		"fmt": "biome format --write .",
		"fix": "biome check --write --unsafe .",
		"lint": "biome lint .",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"check": "biome check . && bun run check:types"
	},
	"dependencies": {
		"@larksuiteoapi/node-sdk": "^1.71.1",
		"@linxiraos/pi-utils": "catalog:"
	},
	"devDependencies": {
		"@linxiraos/pi-ai": "catalog:",
		"@types/bun": "catalog:"
	},
	"peerDependencies": {
		"@linxiraos/pi-ai": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
