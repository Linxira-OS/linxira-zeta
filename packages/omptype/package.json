{
  "type": "module",
  "name": "@linxiraos/zeta-schema",
  "version": "1.4.12",
  "description": "ArkType-compatible runtime schema validation with lazy JIT compilation",
  "homepage": "https://linxira-os.github.io/zeta/",
  "author": "Linxira-OS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linxira-OS/linxira-zeta.git",
    "directory": "packages/omptype"
  },
  "bugs": {
    "url": "https://github.com/Linxira-OS/linxira-zeta/issues"
  },
  "keywords": [
    "schema",
    "validation",
    "arktype",
    "jit"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
    "check:types": "bun check --no-script -p tsconfig.json",
    "lint": "oxlint .",
    "fix": "oxlint --fix --fix-suggestions . && bun run fmt",
    "fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'",
    "test": "bun test --parallel",
    "bench": "bun bench/bench.ts"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.0",
    "@types/bun": "catalog:",
    "arkregex": "0.0.8",
    "arktype": "2.2.3"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./*.js": "./src/*.ts"
  }
}
