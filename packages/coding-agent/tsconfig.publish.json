{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declaration": true,
		"declarationMap": false,
		"sourceMap": false,
		"inlineSources": false,
		"rootDir": "src",
		"outDir": "dist/types",
		"noCheck": true,
		"paths": {
			"@linxiraos/pi-tui": [
				"../tui/dist/types/index.d.ts"
			],
			"@linxiraos/pi-tui/*": [
				"../tui/dist/types/*"
			]
		}
	},
	"include": [
		"src"
	],
	"exclude": [
		"dist",
		"node_modules",
		"test",
		"tests",
		"scripts",
		"bench"
	]
}
