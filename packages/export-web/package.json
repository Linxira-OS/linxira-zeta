{
  "type": "module",
  "name": "@linxiraos/collab-web",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone HTML export viewer assets shared by session export and trace views",
  "homepage": "https://linxira-os.github.io/zeta/",
  "author": "Linxira-OS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linxira-OS/linxira-zeta.git",
    "directory": "packages/collab-web"
  },
  "bugs": {
    "url": "https://github.com/Linxira-OS/linxira-zeta/issues"
  },
  "keywords": [
    "collab",
    "relay",
    "websocket",
    "react",
    "agent"
  ],
  "scripts": {
    "test": "bun test --parallel",
    "check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,scripts}/**/*.ts' '*.ts' && bun run check:types",
    "check:types": "bun check --no-script -p tsconfig.json",
    "lint": "oxlint .",
    "fix": "oxlint --fix --fix-suggestions . && bun run fmt",
    "fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,scripts}/**/*.ts' '*.ts'",
    "gen:export-viewer": "bun scripts/build-export-viewer.ts"
  },
  "dependencies": {
    "@linxiraos/pi-utils": "catalog:",
    "@linxiraos/pi-wire": "catalog:",
    "lucide-react": "catalog:",
    "katex": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@linxiraos/pi-stats": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "files": [
    "src",
    "scripts",
    "README.md"
  ]
}
