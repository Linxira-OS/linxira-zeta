{
	"type": "module",
	"name": "@linxiraos/pi-tui",
	"version": "1.1.17",
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"homepage": "https://linxira-os.github.io/zeta/",
	"author": "Linxira-OS",
	"contributors": [
		"Mario Zechner"
	],
	"license": "MIT",
	"repository": {
		"directory": "packages/tui",
		"url": "git+https://github.com/Linxira-OS/linxira-zeta.git",
		"type": "git"
	},
	"bugs": {
		"url": "https://github.com/Linxira-OS/linxira-zeta/issues"
	},
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"test": "bun test --parallel test/*.test.ts",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'"
	},
	"dependencies": {
		"@linxiraos/pi-natives": "catalog:",
		"@linxiraos/pi-utils": "catalog:",
		"@linxiraos/pi-omptype": "catalog:",
		"@linxiraos/pi-agent-core": "catalog:",
		"@linxiraos/pi-ai": "catalog:",
		"@linxiraos/pi-catalog": "catalog:",
		"@linxiraos/pi-wire": "catalog:",
		"@linxiraos/pi-snapcompact": "catalog:"
	},
	"devDependencies": {
		"kitty-vt-wasm": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./theme": {
			"types": "./src/theme/index.ts",
			"import": "./src/theme/index.ts"
		},
		"./theme/defaults": {
			"types": "./src/theme/defaults/index.ts",
			"import": "./src/theme/defaults/index.ts"
		},
		"./theme/*": {
			"types": "./src/theme/*.ts",
			"import": "./src/theme/*.ts"
		},
		"./render": {
			"types": "./src/render/index.ts",
			"import": "./src/render/index.ts"
		},
		"./chrome": {
			"types": "./src/chrome/index.ts",
			"import": "./src/chrome/index.ts"
		},
		"./tools": {
			"types": "./src/tools/index.ts",
			"import": "./src/tools/index.ts"
		},
		"./status-line": {
			"types": "./src/status-line/index.ts",
			"import": "./src/status-line/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		},
		"./components/*": {
			"types": "./src/components/*.ts",
			"import": "./src/components/*.ts"
		},
		"./*.js": "./src/*.ts"
	}
}
