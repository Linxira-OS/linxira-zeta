{
	"exports": {
		"./*.js": "./src/*.ts",
		"./*": {
			"import": "./src/*.ts",
			"types": "./src/*.ts"
		},
		"./compat/*": {
			"import": "./src/compat/*.ts",
			"types": "./src/compat/*.ts"
		},
		"./wire/*": {
			"import": "./src/wire/*.ts",
			"types": "./src/wire/*.ts"
		},
		"./identity/*": {
			"import": "./src/identity/*.ts",
			"types": "./src/identity/*.ts"
		},
		"./identity": {
			"import": "./src/identity/index.ts",
			"types": "./src/identity/index.ts"
		},
		"./discovery/*": {
			"import": "./src/discovery/*.ts",
			"types": "./src/discovery/*.ts"
		},
		"./discovery": {
			"import": "./src/discovery/index.ts",
			"types": "./src/discovery/index.ts"
		},
		"./provider-models/*": {
			"import": "./src/provider-models/*.ts",
			"types": "./src/provider-models/*.ts"
		},
		"./provider-models": {
			"import": "./src/provider-models/index.ts",
			"types": "./src/provider-models/index.ts"
		},
		"./models.json": {
			"import": "./src/models.json",
			"types": "./src/models.json.d.ts"
		},
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"engines": {
		"bun": ">=1.3.14"
	},
	"devDependencies": {
		"@linxiraos/pi-ai": "catalog:",
		"@types/bun": "catalog:",
		"@bgotink/kdl": "0.4.0"
	},
	"dependencies": {
		"@linxiraos/pi-utils": "catalog:",
		"@linxiraos/pi-omptype": "catalog:"
	},
	"scripts": {
		"gen:proto": "bun scripts/generate-protocols.ts",
		"gen:compat": "bun scripts/compile-compat.ts",
		"gen:models": "bun scripts/generate-models.ts",
		"test": "bun test --parallel",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"types": "./src/index.ts",
	"main": "./src/index.ts",
	"keywords": [
		"ai",
		"llm",
		"models",
		"catalog",
		"discovery"
	],
	"bugs": {
		"url": "https://github.com/Linxira-OS/linxira-zeta/issues"
	},
	"repository": {
		"directory": "packages/catalog",
		"url": "git+https://github.com/Linxira-OS/linxira-zeta.git",
		"type": "git"
	},
	"license": "MIT",
	"author": "Can Boluk",
	"homepage": "https://linxira-os.github.io/zeta/",
	"description": "Model catalog for omp: bundled model database, provider discovery descriptors, model identity, classification, and equivalence",
	"version": "1.1.9",
	"name": "@linxiraos/pi-catalog",
	"type": "module"
}
