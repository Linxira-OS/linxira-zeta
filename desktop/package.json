{
  "name": "zeta-desktop",
  "version": "1.1.6",
  "private": true,
  "packageManager": "npm@12.0.1",
  "author": "Zeta Contributors",
  "description": "Zeta desktop shell: embedded Web UI + Stats dashboard with local service (no terminal, no system browser)",
  "homepage": "https://linxira-os.github.io/zeta/",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node scripts/generate-icon.mjs && tsc -p tsconfig.json",
    "test": "node --test scripts/*.test.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dist": "npm run build && npm run prepare:runtime && node scripts/package-desktop.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "37.10.3",
    "electron-builder": "^26.0.12",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
